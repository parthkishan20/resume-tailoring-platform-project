# .env.example
# Copy this file to .env and fill in your values before running the app.

# Required: Your OpenRouter API key
# Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LLM model used for all tasks (generation, evaluation, chat, PDF import).
# LLM_MODEL's provider prefix picks which key above is read: "openrouter/..."
# reads OPENROUTER_API_KEY, anything else reads OPENAI_API_KEY.
# Default: openrouter/openai/gpt-oss-120b
# NOTE: must be a real OpenRouter slug. `openrouter/free` was the old default
# and does not exist -- the provider answers 404 and every LLM call fails.
LLM_MODEL=openrouter/openai/gpt-oss-120b

# Optional: only needed if you point LLM_MODEL at a bare OpenAI model
# (e.g. gpt-4o-mini) instead of an openrouter/... model.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Set to true to use deterministic mock LLM responses (for testing only)
LLM_MOCK=false

# --- Advanced: LLM call bounds (all optional, sane defaults shown) ---

# Seconds to wait for a provider response before treating the call as failed.
# LLM_TIMEOUT_S=60.0

# How many times to retry a transient failure (rate limit, connection drop,
# provider 500) before giving up. Auth errors and timeouts are never retried.
# LLM_MAX_ATTEMPTS=3

# Base delay between retries, doubled each attempt.
# LLM_RETRY_BACKOFF_S=0.5

# Upper bound on tokens generated per call. Raise this if a tailored resume is
# being truncated; lower it to cap cost per call.
# LLM_MAX_TOKENS=8192

# For a streaming call (chat), how long a gap between tokens is tolerated
# before the stream is treated as stalled.
# LLM_STREAM_STALL_TIMEOUT_S=30.0
