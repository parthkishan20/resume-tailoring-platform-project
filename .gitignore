# Backend build artifacts
backend/__pycache__/
backend/**/__pycache__/

# Database (runtime file, not committed)
db/resumedb.db
# `db/resumedb.db` above is anchored to the repo root (a `/`-containing
# pattern is, per gitignore's own rules) and never matched the real default
# local path `backend/db/resumedb.db` that backup.sh, restore.sh and
# migrate.sh all use — confirmed with `git check-ignore`. Anchored the same
# way, to `backend/db/` specifically: `db/` alone (no other separator) would
# be unanchored and also match the tracked `backend/src/resumetailor/db/`
# package, silently ignoring any new source file added under it.
/backend/db/

# Generated PDFs (runtime, not committed)
pdfs/

# Playwright test results
test/test-results/
test/playwright-report/
tests/e2e/test-results/
tests/e2e/playwright-report/
.playwright-mcp/

# Build artifacts
backend/static/

# Windows
Thumbs.db

# Agent skills installed via `npx skills add` (machine-local, not vendored)
.agents/
skills-lock.json
.claude/skills/

# Personal resume data — contains real PII, must never be committed. The
# glob (not just the exact filename) covers copies/backups like
# master-resume-copy.yaml, which is real PII too and isn't the same file
# every editor or tool names identically.
planning/master-resume*.yaml
*.personal.yaml

# Agent scratch directory from the 2026-07 build. The markdown briefs and
# reports are preserved under docs/archive/superpowers-sdd/; what remains here
# is multi-megabyte raw review dumps that duplicate the git history.
.superpowers/
.worktrees/
